void display7SEG(int num) {
    // Bảng mã Anode chung (0: Sáng, 1: Tắt)
    uint8_t seg_codes[10][7] = {
        {0, 0, 0, 0, 0, 0, 1}, // Số 0
        {1, 0, 0, 1, 1, 1, 1}, // Số 1
        {0, 0, 1, 0, 0, 1, 0}, // Số 2
        {0, 0, 0, 0, 1, 1, 0}, // Số 3
        {1, 0, 0, 1, 1, 0, 0}, // Số 4
        {0, 1, 0, 0, 1, 0, 0}, // Số 5
        {0, 1, 0, 0, 0, 0, 0}, // Số 6
        {0, 0, 0, 1, 1, 1, 1}, // Số 7
        {0, 0, 0, 0, 0, 0, 0}, // Số 8
        {0, 0, 0, 0, 1, 0, 0}  // Số 9
    };

    if (num < 0 || num > 9) return;

    // Sử dụng trực tiếp các Pin từ GPIO_PIN_0 đến GPIO_PIN_6
    HAL_GPIO_WritePin(GPIOB, GPIO_PIN_0, seg_codes[num][0]); // a -> PB0
    HAL_GPIO_WritePin(GPIOB, GPIO_PIN_1, seg_codes[num][1]); // b -> PB1
    HAL_GPIO_WritePin(GPIOB, GPIO_PIN_2, seg_codes[num][2]); // c -> PB2
    HAL_GPIO_WritePin(GPIOB, GPIO_PIN_3, seg_codes[num][3]); // d -> PB3
    HAL_GPIO_WritePin(GPIOB, GPIO_PIN_4, seg_codes[num][4]); // e -> PB4
    HAL_GPIO_WritePin(GPIOB, GPIO_PIN_5, seg_codes[num][5]); // f -> PB5
    HAL_GPIO_WritePin(GPIOB, GPIO_PIN_6, seg_codes[num][6]); // g -> PB6
}
