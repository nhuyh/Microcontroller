#include "main.h"

void SystemClock_Config(void);
static void MX_GPIO_Init(void);

// Hàm tắt tất cả 12 LED
void clearAllClock(void) {
    for (int i = 4; i <= 15; i++) {
        HAL_GPIO_WritePin(GPIOA, (1 << i), GPIO_PIN_RESET);
    }
}

// Hàm bật 1 vị trí LED tương ứng với số trên mặt đồng hồ (1 đến 12)
void setNumberOnClock(int num) {
    if (num < 1 || num > 12) return;

    // Số 12 tương ứng chân PA15, số 1..11 tương ứng PA4..PA14
    if (num == 12) {
        HAL_GPIO_WritePin(GPIOA, GPIO_PIN_15, GPIO_PIN_SET);
    } else {
        HAL_GPIO_WritePin(GPIOA, (1 << (num + 3)), GPIO_PIN_SET);
    }
}

// Hàm tắt 1 vị trí LED tương ứng
void clearNumberOnClock(int num) {
    if (num < 1 || num > 12) return;

    if (num == 12) {
        HAL_GPIO_WritePin(GPIOA, GPIO_PIN_15, GPIO_PIN_RESET);
    } else {
        HAL_GPIO_WritePin(GPIOA, (1 << (num + 3)), GPIO_PIN_RESET);
    }
}

int main(void)
{
  HAL_Init();
  SystemClock_Config();
  MX_GPIO_Init();

  int hour = 0;
  int minute = 0;
  int second = 0;

  while (1)
  {
      clearAllClock();

      // Hiển thị vị trí kim giờ, kim phút, kim giây trên mặt 12 LED
      setNumberOnClock((hour == 0) ? 12 : hour);
      setNumberOnClock((minute / 5 == 0) ? 12 : (minute / 5));
      setNumberOnClock((second / 5 == 0) ? 12 : (second / 5));

      HAL_Delay(1000); // Đếm mỗi giây

      second++;
      if (second >= 60) {
          second = 0;
          minute++;
          if (minute >= 60) {
              minute = 0;
              hour++;
              if (hour >= 12) {
                  hour = 0;
              }
          }
      }
  }
}

