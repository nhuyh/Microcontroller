// EX4 - Hiển thị LED 7 đoạn HOA (A..G) -> Nối PB0..PB6 theo Proteus
void display7SEG(int num)
{
    // 0 = sáng, 1 = tắt
    static const uint8_t code[10] = {
        0b0000001, // 0
        0b1001111, // 1
        0b0010010, // 2
        0b0000110, // 3
        0b1001100, // 4
        0b0100100, // 5
        0b0100000, // 6
        0b0001111, // 7
        0b0000000, // 8
        0b0000100  // 9
    };
    if (num < 0 || num > 9) return;
    uint8_t p = code[num];
    HAL_GPIO_WritePin(GPIOB, GPIO_PIN_0, (p >> 6) & 0x01); // SEG_A
    HAL_GPIO_WritePin(GPIOB, GPIO_PIN_1, (p >> 5) & 0x01); // SEG_B
    HAL_GPIO_WritePin(GPIOB, GPIO_PIN_2, (p >> 4) & 0x01); // SEG_C
    HAL_GPIO_WritePin(GPIOB, GPIO_PIN_3, (p >> 3) & 0x01); // SEG_D
    HAL_GPIO_WritePin(GPIOB, GPIO_PIN_4, (p >> 2) & 0x01); // SEG_E
    HAL_GPIO_WritePin(GPIOB, GPIO_PIN_5, (p >> 1) & 0x01); // SEG_F
    HAL_GPIO_WritePin(GPIOB, GPIO_PIN_6, (p >> 0) & 0x01); // SEG_G
}

// EX4 - Hiển thị LED 7 đoạn THƯỜNG (a..g) -> Nối PB7..PB13 theo Proteus
void display7SEG2(int num)
{
    // 0 = sáng, 1 = tắt
    static const uint8_t code[10] = {
        0b0000001, // 0
        0b1001111, // 1
        0b0010010, // 2
        0b0000110, // 3
        0b1001100, // 4
        0b0100100, // 5
        0b0100000, // 6
        0b0001111, // 7
        0b0000000, // 8
        0b0000100  // 9
    };
    if (num < 0 || num > 9) return;
    uint8_t p = code[num];
    HAL_GPIO_WritePin(GPIOB, GPIO_PIN_7,  (p >> 6) & 0x01); // SEGA
    HAL_GPIO_WritePin(GPIOB, GPIO_PIN_8,  (p >> 5) & 0x01); // SEGB
    HAL_GPIO_WritePin(GPIOB, GPIO_PIN_9,  (p >> 4) & 0x01); // SEGC
    HAL_GPIO_WritePin(GPIOB, GPIO_PIN_10, (p >> 3) & 0x01); // SEGD
    HAL_GPIO_WritePin(GPIOB, GPIO_PIN_11, (p >> 2) & 0x01); // SEGE
    HAL_GPIO_WritePin(GPIOB, GPIO_PIN_12, (p >> 1) & 0x01); // SEGF
    HAL_GPIO_WritePin(GPIOB, GPIO_PIN_13, (p >> 0) & 0x01); // SEGG
}

// EX5 - Hàm đếm ngược đồng bộ đèn và giờ
void trafficPhaseBoth(int nsCount, int ewCount, int seconds)
{
    for (int i = 0; i < seconds; i++)
    {
        display7SEG(nsCount - i);   // SEG1 - đếm ngược cho NS
        display7SEG2(ewCount - i);  // SEG2 - đếm ngược cho EW
        HAL_Delay(1000); // Đợi 1 giây[cite: 2]
    }
}
