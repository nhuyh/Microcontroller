// Hàm bật/tắt 1 đèn đơn
void setLight(GPIO_TypeDef* port, uint16_t pin, GPIO_PinState state) {
    HAL_GPIO_WritePin(port, pin, state);
}

// Hàm tắt toàn bộ đèn giao thông 4 hướng
void allOff(void) {
    setLight(N_RED_GPIO_Port, N_RED_Pin, GPIO_PIN_RESET);
    setLight(N_YELLOW_GPIO_Port, N_YELLOW_Pin, GPIO_PIN_RESET);
    setLight(N_GREEN_GPIO_Port, N_GREEN_Pin, GPIO_PIN_RESET);

    setLight(S_RED_GPIO_Port, S_RED_Pin, GPIO_PIN_RESET);
    setLight(S_YELLOW_GPIO_Port, S_YELLOW_Pin, GPIO_PIN_RESET);
    setLight(S_GREEN_GPIO_Port, S_GREEN_Pin, GPIO_PIN_RESET);

    setLight(E_RED_GPIO_Port, E_RED_Pin, GPIO_PIN_RESET);
    setLight(E_YELLOW_GPIO_Port, E_YELLOW_Pin, GPIO_PIN_RESET);
    setLight(E_GREEN_GPIO_Port, E_GREEN_Pin, GPIO_PIN_RESET);

    setLight(W_RED_GPIO_Port, W_RED_Pin, GPIO_PIN_RESET);
    setLight(W_YELLOW_GPIO_Port, W_YELLOW_Pin, GPIO_PIN_RESET);
    setLight(W_GREEN_GPIO_Port, W_GREEN_Pin, GPIO_PIN_RESET);
}

// Hiển thị LED 7 đoạn 1 (Hướng Bắc - Nam: N/S)
void display7SEG(int num)
{
    static const uint8_t code[10] = {
        0b0000001, // 0
        0b1001111, // 1
        0b0010010, // 2
        0b0000110, // 3
        0b1001100, // 4
        0b0100100, // 5
        0b0100000, // 6
        0b0001111, // 7
        0b0000000, // 8
        0b0000100  // 9
    };
    if (num < 0 || num > 9) return;
    uint8_t p = code[num];
    HAL_GPIO_WritePin(SEG_A_GPIO_Port, SEG_A_Pin, (p >> 6) & 0x01);
    HAL_GPIO_WritePin(SEG_B_GPIO_Port, SEG_B_Pin, (p >> 5) & 0x01);
    HAL_GPIO_WritePin(SEG_C_GPIO_Port, SEG_C_Pin, (p >> 4) & 0x01);
    HAL_GPIO_WritePin(SEG_D_GPIO_Port, SEG_D_Pin, (p >> 3) & 0x01);
    HAL_GPIO_WritePin(SEG_E_GPIO_Port, SEG_E_Pin, (p >> 2) & 0x01);
    HAL_GPIO_WritePin(SEG_F_GPIO_Port, SEG_F_Pin, (p >> 1) & 0x01);
    HAL_GPIO_WritePin(SEG_G_GPIO_Port, SEG_G_Pin, (p >> 0) & 0x01);
}

// Hiển thị LED 7 đoạn 2 (Hướng Đông - Tây: E/W)
void display7SEG2(int num)
{
    static const uint8_t code[10] = {
        0b0000001, // 0
        0b1001111, // 1
        0b0010010, // 2
        0b0000110, // 3
        0b1001100, // 4
        0b0100100, // 5
        0b0100000, // 6
        0b0001111, // 7
        0b0000000, // 8
        0b0000100  // 9
    };
    if (num < 0 || num > 9) return;
    uint8_t p = code[num];
    HAL_GPIO_WritePin(SEGA_GPIO_Port, SEGA_Pin, (p >> 6) & 0x01);
    HAL_GPIO_WritePin(SEGB_GPIO_Port, SEGB_Pin, (p >> 5) & 0x01);
    HAL_GPIO_WritePin(SEGC_GPIO_Port, SEGC_Pin, (p >> 4) & 0x01);
    HAL_GPIO_WritePin(SEGD_GPIO_Port, SEGD_Pin, (p >> 3) & 0x01);
    HAL_GPIO_WritePin(SEGE_GPIO_Port, SEGE_Pin, (p >> 2) & 0x01);
    HAL_GPIO_WritePin(SEGF_GPIO_Port, SEGF_Pin, (p >> 1) & 0x01);
    HAL_GPIO_WritePin(SEGG_GPIO_Port, SEGG_Pin, (p >> 0) & 0x01);
}

// Hàm thực thi chạy đếm ngược từng giây trong mỗi Pha
void trafficPhaseBoth(int nsStart, int ewStart, int seconds)
{
    for (int i = 0; i < seconds; i++)
    {
        display7SEG(nsStart - i);   // Đếm ngược cho Bắc-Nam
        display7SEG2(ewStart - i);  // Đếm ngược cho Đông-Tây
        HAL_Delay(1000); // Đợi 1 giây[cite: 2]
    }
}
/* USER CODE END 0 */

int main(void)
{
  HAL_Init();
  SystemClock_Config();
  MX_GPIO_Init();

  /* USER CODE BEGIN WHILE */
  while (1)
  {
      // -------------------------------------------------------------
      // PHA 1: Hướng N/S XANH (3s)  |  Hướng E/W ĐỎ (5s)
      // -------------------------------------------------------------
      allOff();
      setLight(N_GREEN_GPIO_Port, N_GREEN_Pin, GPIO_PIN_SET);
      setLight(S_GREEN_GPIO_Port, S_GREEN_Pin, GPIO_PIN_SET);
      setLight(E_RED_GPIO_Port, E_RED_Pin, GPIO_PIN_SET);
      setLight(W_RED_GPIO_Port, W_RED_Pin, GPIO_PIN_SET);

      // N/S đếm: 3, 2, 1 | E/W đếm: 5, 4, 3
      trafficPhaseBoth(3, 5, 3);

      // -------------------------------------------------------------
      // PHA 2: Hướng N/S VÀNG (2s)  |  Hướng E/W ĐỎ (tiếp tục 2s còn lại)
      // -------------------------------------------------------------
      allOff();
      setLight(N_YELLOW_GPIO_Port, N_YELLOW_Pin, GPIO_PIN_SET);
      setLight(S_YELLOW_GPIO_Port, S_YELLOW_Pin, GPIO_PIN_SET);
      setLight(E_RED_GPIO_Port, E_RED_Pin, GPIO_PIN_SET);
      setLight(W_RED_GPIO_Port, W_RED_Pin, GPIO_PIN_SET);

      // N/S đếm: 2, 1 | E/W đếm: 2, 1
      trafficPhaseBoth(2, 2, 2);

      // -------------------------------------------------------------
      // PHA 3: Hướng N/S ĐỎ (5s)    |  Hướng E/W XANH (3s)
      // -------------------------------------------------------------
      allOff();
      setLight(N_RED_GPIO_Port, N_RED_Pin, GPIO_PIN_SET);
      setLight(S_RED_GPIO_Port, S_RED_Pin, GPIO_PIN_SET);
      setLight(E_GREEN_GPIO_Port, E_GREEN_Pin, GPIO_PIN_SET);
      setLight(W_GREEN_GPIO_Port, W_GREEN_Pin, GPIO_PIN_SET);

      // N/S đếm: 5, 4, 3 | E/W đếm: 3, 2, 1
      trafficPhaseBoth(5, 3, 3);

      // -------------------------------------------------------------
      // PHA 4: Hướng N/S ĐỎ (tiếp tục 2s) | Hướng E/W VÀNG (2s)
      // -------------------------------------------------------------
      allOff();
      setLight(N_RED_GPIO_Port, N_RED_Pin, GPIO_PIN_SET);
      setLight(S_RED_GPIO_Port, S_RED_Pin, GPIO_PIN_SET);
      setLight(E_YELLOW_GPIO_Port, E_YELLOW_Pin, GPIO_PIN_SET);
      setLight(W_YELLOW_GPIO_Port, W_YELLOW_Pin, GPIO_PIN_SET);

      // N/S đếm: 2, 1 | E/W đếm: 2, 1
      trafficPhaseBoth(2, 2, 2);

    /* USER CODE END WHILE */
  }
}

