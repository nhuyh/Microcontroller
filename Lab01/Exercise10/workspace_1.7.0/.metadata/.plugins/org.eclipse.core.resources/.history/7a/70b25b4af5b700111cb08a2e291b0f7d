// LED 7 đoạn HOA (A..G) -> Nối PB0 đến PB6
void display7SEG(int num)
{
    // Cấu hình Anode chung (0 = Sáng, 1 = Tắt)
    static const uint8_t code[10] = {
        0b0000001, // 0
        0b1001111, // 1
        0b0010010, // 2
        0b0000110, // 3
        0b1001100, // 4
        0b0100100, // 5
        0b0100000, // 6
        0b0001111, // 7
        0b0000000, // 8
        0b0000100  // 9
    };
    if (num < 0 || num > 9) return;
    uint8_t p = code[num];
    HAL_GPIO_WritePin(GPIOB, GPIO_PIN_0, (p >> 6) & 0x01); // A
    HAL_GPIO_WritePin(GPIOB, GPIO_PIN_1, (p >> 5) & 0x01); // B
    HAL_GPIO_WritePin(GPIOB, GPIO_PIN_2, (p >> 4) & 0x01); // C
    HAL_GPIO_WritePin(GPIOB, GPIO_PIN_3, (p >> 3) & 0x01); // D
    HAL_GPIO_WritePin(GPIOB, GPIO_PIN_4, (p >> 2) & 0x01); // E
    HAL_GPIO_WritePin(GPIOB, GPIO_PIN_5, (p >> 1) & 0x01); // F
    HAL_GPIO_WritePin(GPIOB, GPIO_PIN_6, (p >> 0) & 0x01); // G
}

// LED 7 đoạn THƯỜNG (a..g) -> Nối PB7 đến PB13
void display7SEG2(int num)
{
    // Cấu hình Anode chung (0 = Sáng, 1 = Tắt)
    static const uint8_t code[10] = {
        0b0000001, // 0
        0b1001111, // 1
        0b0010010, // 2
        0b0000110, // 3
        0b1001100, // 4
        0b0100100, // 5
        0b0100000, // 6
        0b0001111, // 7
        0b0000000, // 8
        0b0000100  // 9
    };
    if (num < 0 || num > 9) return;
    uint8_t p = code[num];
    HAL_GPIO_WritePin(GPIOB, GPIO_PIN_7,  (p >> 6) & 0x01); // a
    HAL_GPIO_WritePin(GPIOB, GPIO_PIN_8,  (p >> 5) & 0x01); // b
    HAL_GPIO_WritePin(GPIOB, GPIO_PIN_9,  (p >> 4) & 0x01); // c
    HAL_GPIO_WritePin(GPIOB, GPIO_PIN_10, (p >> 3) & 0x01); // d
    HAL_GPIO_WritePin(GPIOB, GPIO_PIN_11, (p >> 2) & 0x01); // e
    HAL_GPIO_WritePin(GPIOB, GPIO_PIN_12, (p >> 1) & 0x01); // f
    HAL_GPIO_WritePin(GPIOB, GPIO_PIN_13, (p >> 0) & 0x01); // g
}

// Hàm đếm ngược đồng bộ 2 màn hình LED 7 đoạn
void trafficPhaseBoth(int startLeftRight, int startTopBottom, int seconds)
{
    for (int i = 0; i < seconds; i++)
    {
        display7SEG(startLeftRight - i);  // LED Trái/Phải (Hoa A..G)
        display7SEG2(startTopBottom - i); // LED Trên/Dưới (Thường a..g)
        HAL_Delay(1000);
    }
}

/**
  * @brief  The application entry point.
  * @retval int
  */
int main(void)
{
  /* MCU Configuration--------------------------------------------------------*/
  HAL_Init();
  SystemClock_Config();
  MX_GPIO_Init();

  /* Infinite loop */
  /* USER CODE BEGIN WHILE */
  while (1)
  {
      /* --------------------------------------------------------------------
       * Pha 1: TRÁI/PHẢI XANH (PA2 - 3s) --- TRÊN/DƯỚI ĐỎ (PA5 - 5s)
       * -------------------------------------------------------------------- */
      HAL_GPIO_WritePin(GPIOA, GPIO_PIN_0 | GPIO_PIN_1 | GPIO_PIN_2 |
                               GPIO_PIN_3 | GPIO_PIN_4 | GPIO_PIN_5, GPIO_PIN_RESET);

      // Bật GREEN Trái/Phải (PA2) VÀ RED Trên/Dưới (PA5)
      HAL_GPIO_WritePin(GPIOA, GPIO_PIN_2 | GPIO_PIN_5, GPIO_PIN_SET);
      trafficPhaseBoth(3, 5, 3); // Chạy 3 giây (Trái/Phải đếm 3->1, Trên/Dưới đếm 5->3)


      /* --------------------------------------------------------------------
       * Pha 2: TRÁI/PHẢI VÀNG (PA1 - 2s) --- TRÊN/DƯỚI ĐỎ (PA5 - 2s còn lại)
       * -------------------------------------------------------------------- */
      HAL_GPIO_WritePin(GPIOA, GPIO_PIN_0 | GPIO_PIN_1 | GPIO_PIN_2 |
                               GPIO_PIN_3 | GPIO_PIN_4 | GPIO_PIN_5, GPIO_PIN_RESET);

      // Bật YELLOW Trái/Phải (PA1) VÀ RED Trên/Dưới (PA5)
      HAL_GPIO_WritePin(GPIOA, GPIO_PIN_1 | GPIO_PIN_5, GPIO_PIN_SET);
      trafficPhaseBoth(2, 2, 2); // Chạy 2 giây (Cả 2 bên cùng đếm 2->1)


      /* --------------------------------------------------------------------
       * Pha 3: TRÁI/PHẢI ĐỎ (PA0 - 5s) --- TRÊN/DƯỚI XANH (PA3 - 3s)
       * -------------------------------------------------------------------- */
      HAL_GPIO_WritePin(GPIOA, GPIO_PIN_0 | GPIO_PIN_1 | GPIO_PIN_2 |
                               GPIO_PIN_3 | GPIO_PIN_4 | GPIO_PIN_5, GPIO_PIN_RESET);

      // Bật RED Trái/Phải (PA0) VÀ GREEN Trên/Dưới (PA3)
      HAL_GPIO_WritePin(GPIOA, GPIO_PIN_0 | GPIO_PIN_3, GPIO_PIN_SET);
      trafficPhaseBoth(5, 3, 3); // Chạy 3 giây (Trái/Phải đếm 5->3, Trên/Dưới đếm 3->1)


      /* --------------------------------------------------------------------
       * Pha 4: TRÁI/PHẢI ĐỎ (PA0 - 2s còn lại) --- TRÊN/DƯỚI VÀNG (PA4 - 2s)
       * -------------------------------------------------------------------- */
      HAL_GPIO_WritePin(GPIOA, GPIO_PIN_0 | GPIO_PIN_1 | GPIO_PIN_2 |
                               GPIO_PIN_3 | GPIO_PIN_4 | GPIO_PIN_5, GPIO_PIN_RESET);

      // Bật RED Trái/Phải (PA0) VÀ YELLOW Trên/Dưới (PA4)
      HAL_GPIO_WritePin(GPIOA, GPIO_PIN_0 | GPIO_PIN_4, GPIO_PIN_SET);
      trafficPhaseBoth(2, 2, 2); // Chạy 2 giây (Cả 2 bên cùng đếm 2->1)

    /* USER CODE END WHILE */

    /* USER CODE BEGIN 3 */
  }
  /* USER CODE END 3 */
}

