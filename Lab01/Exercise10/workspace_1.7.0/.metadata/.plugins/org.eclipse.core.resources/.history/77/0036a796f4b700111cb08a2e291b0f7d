int main(void)
{
  HAL_Init();
  SystemClock_Config();
  MX_GPIO_Init();

  /* USER CODE BEGIN 2 */
  // Giữ nguyên các biến khởi tạo của Bài 3
  int count1 = 5; // Hướng 1 bắt đầu Đỏ 5s
  int count2 = 3; // Hướng 2 bắt đầu Xanh 3s
  int status = 0; // Trạng thái giao thông bài 3
  /* USER CODE END 2 */

  /* USER CODE BEGIN WHILE */
  while (1)
  {
      // --- GIỮ NGUYÊN LOGIC BẬT ĐÈN CỦA BÀI 3 ---
      if (status == 0) {
          // Hướng 1: Đỏ sáng | Hướng 2: Xanh sáng
          HAL_GPIO_WritePin(GPIOA, GPIO_PIN_7, GPIO_PIN_SET);   // RED 1
          HAL_GPIO_WritePin(GPIOA, GPIO_PIN_8, GPIO_PIN_RESET); // YELLOW 1
          HAL_GPIO_WritePin(GPIOA, GPIO_PIN_9, GPIO_PIN_RESET); // GREEN 1

          HAL_GPIO_WritePin(GPIOA, GPIO_PIN_10, GPIO_PIN_RESET); // RED 2
          HAL_GPIO_WritePin(GPIOA, GPIO_PIN_11, GPIO_PIN_RESET); // YELLOW 2
          HAL_GPIO_WritePin(GPIOA, GPIO_PIN_12, GPIO_PIN_SET);   // GREEN 2
      }
      else if (status == 1) {
          // Hướng 1: Đỏ sáng | Hướng 2: Vàng sáng
          HAL_GPIO_WritePin(GPIOA, GPIO_PIN_7, GPIO_PIN_SET);
          HAL_GPIO_WritePin(GPIOA, GPIO_PIN_8, GPIO_PIN_RESET);
          HAL_GPIO_WritePin(GPIOA, GPIO_PIN_9, GPIO_PIN_RESET);

          HAL_GPIO_WritePin(GPIOA, GPIO_PIN_10, GPIO_PIN_RESET);
          HAL_GPIO_WritePin(GPIOA, GPIO_PIN_11, GPIO_PIN_SET);
          HAL_GPIO_WritePin(GPIOA, GPIO_PIN_12, GPIO_PIN_RESET);
      }
      else if (status == 2) {
          // Hướng 1: Xanh sáng | Hướng 2: Đỏ sáng
          HAL_GPIO_WritePin(GPIOA, GPIO_PIN_7, GPIO_PIN_RESET);
          HAL_GPIO_WritePin(GPIOA, GPIO_PIN_8, GPIO_PIN_RESET);
          HAL_GPIO_WritePin(GPIOA, GPIO_PIN_9, GPIO_PIN_SET);

          HAL_GPIO_WritePin(GPIOA, GPIO_PIN_10, GPIO_PIN_SET);
          HAL_GPIO_WritePin(GPIOA, GPIO_PIN_11, GPIO_PIN_RESET);
          HAL_GPIO_WritePin(GPIOA, GPIO_PIN_12, GPIO_PIN_RESET);
      }
      else if (status == 3) {
          // Hướng 1: Vàng sáng | Hướng 2: Đỏ sáng
          HAL_GPIO_WritePin(GPIOA, GPIO_PIN_7, GPIO_PIN_RESET);
          HAL_GPIO_WritePin(GPIOA, GPIO_PIN_8, GPIO_PIN_SET);
          HAL_GPIO_WritePin(GPIOA, GPIO_PIN_9, GPIO_PIN_RESET);

          HAL_GPIO_WritePin(GPIOA, GPIO_PIN_10, GPIO_PIN_SET);
          HAL_GPIO_WritePin(GPIOA, GPIO_PIN_11, GPIO_PIN_RESET);
          HAL_GPIO_WritePin(GPIOA, GPIO_PIN_12, GPIO_PIN_RESET);
      }

      // --- CHỈ THÊM 2 DÒNG NÀY ĐỂ XUẤT THỜI GIAN RA LED 7 ĐOẠN ---
      display7SEG_1(count1);
      display7SEG_2(count2);

      HAL_Delay(1000); // Đợi 1 giây[cite: 2]

      // --- GIỮ NGUYÊN LOGIC GIẢM BỘ ĐẾM BÀI 3 ---
      count1--;
      count2--;

      // CHUYỂN TRẠNG THÁI THEO DÚNG PHẦN ĐẾM CỦA BÀI 3
      if (count2 <= 0 && status == 0) {
          status = 1;
          count2 = 2; // Hướng 2 chuyển Vàng đếm 2s
      }
      else if (count1 <= 0 && status == 1) {
          status = 2;
          count1 = 3; // Hướng 1 chuyển Xanh đếm 3s
          count2 = 5; // Hướng 2 chuyển Đỏ đếm 5s
      }
      else if (count1 <= 0 && status == 2) {
          status = 3;
          count1 = 2; // Hướng 1 chuyển Vàng đếm 2s
      }
      else if (count2 <= 0 && status == 3) {
          status = 0;
          count1 = 5; // Hướng 1 chuyển Đỏ đếm 5s
          count2 = 3; // Hướng 2 chuyển Xanh đếm 3s
      }

    /* USER CODE END WHILE */
  }
}

