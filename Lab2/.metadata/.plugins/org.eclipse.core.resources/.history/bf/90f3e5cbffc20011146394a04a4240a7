  sMasterConfig.MasterSlaveMode = TIM_MASTERSLAVEMODE_DISABLE;
  if (HAL_TIMEx_MasterConfigSynchronization(&htim2, &sMasterConfig) != HAL_OK) Error_Handler();
}

static void MX_GPIO_Init(void)
{
  GPIO_InitTypeDef g = {0};
  uint16_t pa_mask = 0xFFFC;   /* PA2..PA15 */
  uint16_t pb_mask = 0xFF7F;   /* PB0..PB6 va PB8..PB15 */
  int i;

  __HAL_RCC_GPIOA_CLK_ENABLE();
  __HAL_RCC_GPIOB_CLK_ENABLE();

  /* muc ban dau */
  for (i = 0; i < 8; i++)
  {
      HAL_GPIO_WritePin(GPIOA, col_pin[i], COL_ON_LEVEL == GPIO_PIN_SET ? GPIO_PIN_RESET : GPIO_PIN_SET);
      HAL_GPIO_WritePin(GPIOB, row_pin[i], ROW_ON_LEVEL == GPIO_PIN_SET ? GPIO_PIN_RESET : GPIO_PIN_SET);
  }
  for (i = 0; i < 4; i++) HAL_GPIO_WritePin(GPIOA, en_pin[i], GPIO_PIN_SET);
  for (i = 0; i < 7; i++) HAL_GPIO_WritePin(GPIOB, seg_pin[i], GPIO_PIN_SET);
  HAL_GPIO_WritePin(GPIOA, DOT_PIN, GPIO_PIN_RESET);      /* D2, D3 sang */
  HAL_GPIO_WritePin(GPIOA, LEDRED_PIN, GPIO_PIN_RESET);   /* D1 sang     */

  g.Mode = GPIO_MODE_OUTPUT_PP;
  g.Pull = GPIO_NOPULL;
  g.Speed = GPIO_SPEED_FREQ_LOW;

  g.Pin = pa_mask;  HAL_GPIO_Init(GPIOA, &g);
  g.Pin = pb_mask;  HAL_GPIO_Init(GPIOB, &g);
}

/* USER CODE BEGIN 4 */
void HAL_TIM_PeriodElapsedCallback(TIM_HandleTypeDef *htim)
{
    if (htim->Instance == TIM2) timer_run();
}
/* USER CODE END 4 */

void Error_Handler(void)
{
  __disable_irq();
  while (1) {}
}
