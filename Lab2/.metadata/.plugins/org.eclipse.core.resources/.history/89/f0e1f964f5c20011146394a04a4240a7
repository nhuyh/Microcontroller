TIM_HandleTypeDef htim2;
#define MAX_LED 4
#define TIMER_CYCLE 10
int led_buffer[4]={1,2,3,4}, index_led=0;
int hour=15, minute=8, second=50, dot_state=0;
volatile int timer0_counter=0,timer0_flag=0;
volatile int timer1_counter=0,timer1_flag=0;
volatile int timer2_counter=0,timer2_flag=0;
volatile int scan_counter=0,dot_counter=0;
void SystemClock_Config(void); static void MX_GPIO_Init(void); static void MX_TIM2_Init(void);
void clear7SEG(void); void display7SEG(int n); void disableAllDigits(void); void update7SEG(int i);
void updateClockBuffer(void); void setTimer0(int d); void setTimer1(int d); void setTimer2(int d); void timer_run(void);

void clear7SEG(void){ HAL_GPIO_WritePin(GPIOB, GPIO_PIN_0|GPIO_PIN_1|GPIO_PIN_2|GPIO_PIN_3|GPIO_PIN_4|GPIO_PIN_5|GPIO_PIN_6,GPIO_PIN_SET); }
void display7SEG(int n){
 const unsigned char c[10]={0x40,0x79,0x24,0x30,0x19,0x12,0x02,0x78,0x00,0x10};
 if(n<0||n>9){clear7SEG();return;}
 HAL_GPIO_WritePin(GPIOB,GPIO_PIN_0,(c[n]&1)?GPIO_PIN_SET:GPIO_PIN_RESET);
 HAL_GPIO_WritePin(GPIOB,GPIO_PIN_1,(c[n]&2)?GPIO_PIN_SET:GPIO_PIN_RESET);
 HAL_GPIO_WritePin(GPIOB,GPIO_PIN_2,(c[n]&4)?GPIO_PIN_SET:GPIO_PIN_RESET);
 HAL_GPIO_WritePin(GPIOB,GPIO_PIN_3,(c[n]&8)?GPIO_PIN_SET:GPIO_PIN_RESET);
 HAL_GPIO_WritePin(GPIOB,GPIO_PIN_4,(c[n]&16)?GPIO_PIN_SET:GPIO_PIN_RESET);
 HAL_GPIO_WritePin(GPIOB,GPIO_PIN_5,(c[n]&32)?GPIO_PIN_SET:GPIO_PIN_RESET);
 HAL_GPIO_WritePin(GPIOB,GPIO_PIN_6,(c[n]&64)?GPIO_PIN_SET:GPIO_PIN_RESET);
}
void disableAllDigits(void){HAL_GPIO_WritePin(GPIOA,GPIO_PIN_6|GPIO_PIN_7|GPIO_PIN_8|GPIO_PIN_9,GPIO_PIN_SET);}
void update7SEG(int i){
 disableAllDigits(); if(i<0||i>=4){clear7SEG();return;} display7SEG(led_buffer[i]);
 switch(i){case 0:HAL_GPIO_WritePin(GPIOA,GPIO_PIN_6,GPIO_PIN_RESET);break;
 case 1:HAL_GPIO_WritePin(GPIOA,GPIO_PIN_7,GPIO_PIN_RESET);break;
 case 2:HAL_GPIO_WritePin(GPIOA,GPIO_PIN_8,GPIO_PIN_RESET);break;
 case 3:HAL_GPIO_WritePin(GPIOA,GPIO_PIN_9,GPIO_PIN_RESET);break;default:break;}
}
void updateClockBuffer(void){led_buffer[0]=hour/10;led_buffer[1]=hour%10;led_buffer[2]=minute/10;led_buffer[3]=minute%10;}
void setTimer0(int d){timer0_counter=d/TIMER_CYCLE;timer0_flag=0;}
void setTimer1(int d){timer1_counter=d/TIMER_CYCLE;timer1_flag=0;}
void setTimer2(int d){timer2_counter=d/TIMER_CYCLE;timer2_flag=0;}
void timer_run(void){
 if(timer0_counter>0&&--timer0_counter==0)timer0_flag=1;
 if(timer1_counter>0&&--timer1_counter==0)timer1_flag=1;
 if(timer2_counter>0&&--timer2_counter==0)timer2_flag=1;
}
