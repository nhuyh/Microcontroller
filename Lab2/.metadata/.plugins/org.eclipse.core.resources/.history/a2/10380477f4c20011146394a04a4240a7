
#include "main.h"

/* ==================== VARIABLES ==================== */

TIM_HandleTypeDef htim2;

#define MAX_LED 4
#define TIMER_CYCLE 10

/* EN0=PA6, EN1=PA7, EN2=PA8, EN3=PA9 */
int led_buffer[MAX_LED] = {1, 5, 0, 8};

/* Digital clock: HH:MM */
int hour = 15;
int minute = 8;
int second = 50;

/* Software timers */
volatile int timer0_counter = 0;
volatile int timer0_flag = 0;

volatile int timer1_counter = 0;
volatile int timer1_flag = 0;

volatile int timer2_counter = 0;
volatile int timer2_flag = 0;

/* Display scanning */
int index_led = 0;

/* DOT state */
int dot_state = 0;

/* ==================== FUNCTION PROTOTYPES ==================== */

void SystemClock_Config(void);
static void MX_GPIO_Init(void);
static void MX_TIM2_Init(void);

void clear7SEG(void);
void display7SEG(int num);
void update7SEG(int index);
void updateClockBuffer(void);
void updateClock(void);

void setTimer0(int duration);
void setTimer1(int duration);
void setTimer2(int duration);
void timer_run(void);

/* ==================== SOFTWARE TIMERS ==================== */

void setTimer0(int duration)
{
    timer0_counter = duration / TIMER_CYCLE;
    timer0_flag = 0;
}

void setTimer1(int duration)
{
    timer1_counter = duration / TIMER_CYCLE;
    timer1_flag = 0;
}

void setTimer2(int duration)
{
    timer2_counter = duration / TIMER_CYCLE;
    timer2_flag = 0;
}

void timer_run(void)
{
    if (timer0_counter > 0)
    {
        timer0_counter--;

        if (timer0_counter == 0)
            timer0_flag = 1;
    }

    if (timer1_counter > 0)
    {
        timer1_counter--;

        if (timer1_counter == 0)
            timer1_flag = 1;
    }

    if (timer2_counter > 0)
    {
        timer2_counter--;

        if (timer2_counter == 0)
            timer2_flag = 1;
    }
}

/* ==================== 7-SEGMENT DISPLAY ==================== */

/*
   PB0 = a
   PB1 = b
   PB2 = c
   PB3 = d
   PB4 = e
   PB5 = f
   PB6 = g

   Common-anode:
   RESET = segment ON
   SET   = segment OFF
*/

void clear7SEG(void)
{
    HAL_GPIO_WritePin(GPIOB,
        GPIO_PIN_0 | GPIO_PIN_1 | GPIO_PIN_2 |
        GPIO_PIN_3 | GPIO_PIN_4 | GPIO_PIN_5 |
        GPIO_PIN_6,
        GPIO_PIN_SET);
}

void display7SEG(int num)
{
    const unsigned char code[10] =
    {
        0x40,  /* 0 */
        0x79,  /* 1 */
        0x24,  /* 2 */
        0x30,  /* 3 */
        0x19,  /* 4 */
        0x12,  /* 5 */
        0x02,  /* 6 */
        0x78,  /* 7 */
        0x00,  /* 8 */
        0x10   /* 9 */
    };

    if (num < 0 || num > 9)
    {
        clear7SEG();
        return;
    }

    HAL_GPIO_WritePin(GPIOB, GPIO_PIN_0,
        (code[num] & 0x01) ? GPIO_PIN_SET : GPIO_PIN_RESET);

    HAL_GPIO_WritePin(GPIOB, GPIO_PIN_1,
        (code[num] & 0x02) ? GPIO_PIN_SET : GPIO_PIN_RESET);

    HAL_GPIO_WritePin(GPIOB, GPIO_PIN_2,
        (code[num] & 0x04) ? GPIO_PIN_SET : GPIO_PIN_RESET);

    HAL_GPIO_WritePin(GPIOB, GPIO_PIN_3,
        (code[num] & 0x08) ? GPIO_PIN_SET : GPIO_PIN_RESET);

    HAL_GPIO_WritePin(GPIOB, GPIO_PIN_4,
        (code[num] & 0x10) ? GPIO_PIN_SET : GPIO_PIN_RESET);

    HAL_GPIO_WritePin(GPIOB, GPIO_PIN_5,
        (code[num] & 0x20) ? GPIO_PIN_SET : GPIO_PIN_RESET);

    HAL_GPIO_WritePin(GPIOB, GPIO_PIN_6,
        (code[num] & 0x40) ? GPIO_PIN_SET : GPIO_PIN_RESET);
}

/* Turn off all four displays */
void disableAllDigits(void)
{
    HAL_GPIO_WritePin(GPIOA,
        GPIO_PIN_6 | GPIO_PIN_7 |
        GPIO_PIN_8 | GPIO_PIN_9,
        GPIO_PIN_SET);
}

/* Exercise 3: select one display */
void update7SEG(int index)
{
    disableAllDigits();

    if (index < 0 || index >= MAX_LED)
    {
        clear7SEG();
        return;
    }

    display7SEG(led_buffer[index]);

    switch (index)
    {
        case 0:
            HAL_GPIO_WritePin(GPIOA, GPIO_PIN_6, GPIO_PIN_RESET);
            break;

        case 1:
            HAL_GPIO_WritePin(GPIOA, GPIO_PIN_7, GPIO_PIN_RESET);
            break;

        case 2:
            HAL_GPIO_WritePin(GPIOA, GPIO_PIN_8, GPIO_PIN_RESET);
            break;

        case 3:
            HAL_GPIO_WritePin(GPIOA, GPIO_PIN_9, GPIO_PIN_RESET);
            break;

        default:
            break;
    }
}

/* ==================== DIGITAL CLOCK ==================== */

/* Exercise 5: convert HH:MM into four digits */
void updateClockBuffer(void)
{
    led_buffer[0] = hour / 10;
    led_buffer[1] = hour % 10;
    led_buffer[2] = minute / 10;
    led_buffer[3] = minute % 10;
}

/* Update time by one second */
void updateClock(void)
{
    second++;

    if (second >= 60)
    {
        second = 0;
        minute++;
    }

    if (minute >= 60)
    {
        minute = 0;
        hour++;
    }

    if (hour >= 24)
    {
        hour = 0;
    }

    updateClockBuffer();
}

/* ==================== MAIN ==================== */

int main(void)
{
    HAL_Init();

    SystemClock_Config();

    MX_GPIO_Init();
    MX_TIM2_Init();

    clear7SEG();
    disableAllDigits();

    /* PA5: red LED always ON, active-low */
    HAL_GPIO_WritePin(GPIOA, GPIO_PIN_5, GPIO_PIN_RESET);

    /* PA4: DOT initially OFF */
    HAL_GPIO_WritePin(GPIOA, GPIO_PIN_4, GPIO_PIN_SET);

    updateClockBuffer();

    /* Start software timers */
    setTimer0(1000);  /* Clock: one second */
    setTimer1(10);    /* Display scanning */
    setTimer2(1000);  /* DOT: one second */

    HAL_TIM_Base_Start_IT(&htim2);

    while (1)
    {
        /*
           Exercise 8:
           Display scanning is performed in main(),
           not inside the timer interrupt.
        */

        if (timer1_flag == 1)
        {
            update7SEG(index_led);

            index_led++;

            if (index_led >= MAX_LED)
                index_led = 0;

            setTimer1(10);
        }

        /*
           Exercise 7:
           Update the clock without HAL_Delay(1000).
        */

        if (timer0_flag == 1)
        {
            updateClock();

            setTimer0(1000);
        }

        /* DOT connected to PA4 blinks every second */
        if (timer2_flag == 1)
        {
            dot_state = !dot_state;

            HAL_GPIO_WritePin(GPIOA, GPIO_PIN_4,
                dot_state ? GPIO_PIN_RESET : GPIO_PIN_SET);

            setTimer2(1000);
        }
    }
}

